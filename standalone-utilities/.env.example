# Jira Cloud Configuration
# Used by: src_misc/, upload_attachment_assets/

# Jira Cloud instance URL
CLOUD_BASE_URL=https://your-company.atlassian.net

# API token (base64 encoded email:api_token)
# Generate: echo -n "email@example.com:api_token" | base64
CLOUD_API_TOKEN=

# Jira Cloud Assets workspace ID (UUID format)
WORKSPACE_ID=your-workspace-id

# (Optional) For add_user_to_all_project_roles.js
# Find via: GET /rest/api/3/user/search?query=<email>
USER_ACCOUNT_ID=
