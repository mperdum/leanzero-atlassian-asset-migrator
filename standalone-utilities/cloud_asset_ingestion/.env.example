# Cloud Asset Ingestion Configuration
# This utility loads environment from: asset-migration-script/.env
# Copy asset-migration-script/.env.example to asset-migration-script/.env and configure there.
#
# Required variables:
#   CLOUD_BASE_URL    - Jira Cloud instance URL
#   WORKSPACE_ID      - Assets workspace ID
#   CLOUD_API_TOKEN   - Base64 encoded email:api_token
#
# Optional variables:
#   DEBUG=true                    - Enable debug logging
#   SANDBOX_MODE=true             - Target sandbox instance instead of production
#   SANDBOX_CLOUD_BASE_URL=       - Override sandbox URL
#   SANDBOX_WORKSPACE_ID=         - Override sandbox workspace ID
#   SANDBOX_CLOUD_API_TOKEN=      - Override sandbox API token
