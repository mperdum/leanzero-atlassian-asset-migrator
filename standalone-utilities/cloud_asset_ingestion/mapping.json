{
  "_comment": "Mapping file for cloud asset ingestion. Supports per-asset-type mappings.",
  "_usage": "When assetType matches a top-level key, that mapping is used. Otherwise falls back to 'default'.",

  "vInfo": {
    "_objectType": "Virtual Server",
    "_excludeFilter": {
      "column": "Resource pool",
      "startsWith": "/Stuttgart/cluster_vDI/"
    },
    "_statusMapping": {
      "PowerState": {
        "poweredOn": "POWEREDON",
        "poweredOff": "POWEREDOFF"
      },
      "GuestState": {
        "running": "Running",
        "notRunning": "NOTRUNNING"
      }
    },
    "VM": "Name",
    "Powerstate": "PowerState",
    "DNS Name": "DNS Name",
    "Guest state": "GuestState",
    "Consolidation Needed": "Consolidation Needed",
    "CPUs": "CPUs",
    "Memory": "Memory",
    "NICs": "NICs",
    "Disks": "Disks",
    "Primary IP Address": "Primary IP Address",
    "Network #1": "Network #1",
    "HW version": "HW Version",
    "Annotation": "Annotation",
    "Datacenter": "Data Center",
    "Cluster": "Cluster",
    "Host": "Host",
    "OS according to the configuration file": "OS according to the configuration file",
    "VM ID": "VM ID"
  },

  "vCluster": {
    "_objectType": "Cluster",
    "Name": "Name",
    "NumHosts": "NumHosts",
    "TotalCpu": "TotalCpu",
    "NumCpuCores": "NumCpuCores",
    "TotalMemory": "TotalMemory",
    "Object ID": "Object ID"
  },

  "horizon": {
    "_objectType": "Virtual Desktop",
    "_statusMapping": {
      "CONNECTED": "Running",
      "AVAILABLE": "Running",
      "MAINTENANCE": "Running",
      "DISCONNECTED": "NOTRUNNING",
      "AGENT_UNREACHABLE": "NOTRUNNING",
      "PROVISIONED": "INACTIVE"
    },
    "_ownerLookup": {
      "csvColumn": "UserEmail",
      "targetAttribute": "Owner",
      "lookupObjectTypeId": 153,
      "lookupByAttribute": "E-Mail"
    },
    "Name": "Name",
    "Status": "Status",
    "vCenterVMID": "VM ID",
    "OS": "OS",
    "Networks": "Network",
    "SamAccountName": "samaccountname",
    "Owner": "VDI Owner",
    "VDIPool": "Comment"
  }
}
