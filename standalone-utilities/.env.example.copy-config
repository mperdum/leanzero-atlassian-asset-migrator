# Object Assets Configuration Copy Utility
# Copy configuration from source.atlassian.net to source-sandbox.atlassian.net
# Uses the same API token for both instances

# API Configuration (same token for both instances)
CLOUD_API_TOKEN=your_base64_encoded_api_token_here

# Workspace IDs for each instance
SOURCE_WORKSPACE_ID=your_source_workspace_id_here
WORKSPACE_ID=your_target_workspace_id_here

# Optional: Override default URLs if needed
# SOURCE_BASE_URL=https://your-company.atlassian.net
# TARGET_BASE_URL=https://your-company-sandbox.atlassian.net
