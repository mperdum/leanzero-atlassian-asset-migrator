# ====================================
# Jira Cloud Assets Migration Configuration v3.1
# ====================================
# Updated with recent fixes for attachment upload, reference processing,
# text validation, and ticket connection enhancements

# == API Configuration ==
# Your Atlassian domain (without https://)
CLOUD_BASE_URL=your-domain.atlassian.net

# API token for authentication (base64 encoded email:token)
# Format: echo -n "email@example.com:api_token" | base64
CLOUD_API_TOKEN=

# Jira Cloud Assets workspace ID (UUID format)
WORKSPACE_ID=your-workspace-id

# Path to datacenter assets (defaults to ../datacenter_assets)
DATACENTER_PATH=

# == Migration Control ==
# Run in dry-run mode (test without creating objects)
DRY_RUN=false

# Resume a previously interrupted migration
RESUME_MIGRATION=false

# == Filtering Options ==
# Migrate only specific schema (leave empty to migrate all)
SCHEMA_FILTER=

# Migrate only specific object type within schema
TYPE_FILTER=

# Limit number of objects per type (0 = no limit)
LIMIT_PER_TYPE=0

# == Feature Toggles (v3.1 Enhanced) ==
# Connect tickets to migrated objects (now integrated into main flow)
CONNECT_TICKETS_TO_OBJECTS=false

# Upload attachments during migration (fixed authentication & path resolution)
UPLOAD_ATTACHMENTS=false

# Create missing object types automatically
AUTO_CREATE_OBJECT_TYPES=true

# Create missing referenced objects during migration
AUTO_CREATE_REFERENCES=true

# Validate all cross-schema references
VALIDATE_CROSS_SCHEMA_REFS=true

# == Attachment Upload Configuration (Fixed in v3.1) ==
# Maximum attachments to process per object
MAX_ATTACHMENTS_PER_OBJECT=10

# Maximum file size in MB (default: 100MB)
MAX_ATTACHMENT_SIZE_MB=100

# Enable parallel attachment uploads for speed
PARALLEL_ATTACHMENT_UPLOADS=true

# Number of concurrent attachment upload workers
ATTACHMENT_UPLOAD_WORKERS=3

# == Ticket Connection Settings (Enhanced in v3.1) ==
# Maximum number of tickets to connect per object
MAX_TICKETS_PER_OBJECT=10

# Update tickets in parallel (faster but more API load)
PARALLEL_TICKET_UPDATES=true

# Number of parallel ticket update workers
TICKET_UPDATE_WORKERS=5

# Delay between ticket updates in milliseconds
TICKET_UPDATE_DELAY=200

# == Performance Settings ==
# Number of retries for failed API calls
MAX_RETRIES=3

# Initial retry delay in milliseconds
RETRY_DELAY=1000

# Delay between object creations in milliseconds
CREATE_DELAY=100

# Maximum number of objects to fetch per batch
BATCH_SIZE=25

# == Logging Configuration ==
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable detailed error logging
DETAILED_ERROR_LOGGING=true

# Save failed migrations to separate log file
LOG_FAILED_MIGRATIONS=true

# Show detailed progress information
VERBOSE_PROGRESS=false

# == Data Validation (Enhanced in v3.1) ==
# Skip objects with validation errors (NOT RECOMMENDED)
SKIP_VALIDATION_ERRORS=false

# Ignore missing required fields (NOT RECOMMENDED)
IGNORE_MISSING_REQUIRED=false

# Allow partial object migration (NOT RECOMMENDED)
ALLOW_PARTIAL_MIGRATION=false

# == Advanced Options ==
# Enable intelligent migration engine for auto-fixes
INTELLIGENT_MIGRATION=true

# Cache cloud objects for faster lookups
CACHE_CLOUD_OBJECTS=true

# Validate attribute mappings before migration
VALIDATE_ATTRIBUTE_MAPPINGS=true

# == Debug Options ==
# Save all API requests and responses
DEBUG_API_CALLS=false

# Save intermediate mapping results
DEBUG_MAPPINGS=false

# Print detailed progress for each object
VERBOSE_PROGRESS=false

# Enable general debug mode
DEBUG=false

# == Utility Features ==
# Clean all objects from cloud before migration (BE CAREFUL!)
CLEANUP_OBJECTS=false

# Run field type discovery to learn from migration errors
FIELD_DISCOVERY=false

# Analyze datacenter vs cloud configuration differences
DATACENTER_ANALYSIS=false

# Clean circular references from tracking files
CLEAN_CIRCULAR_REFS=false

# Also remove resolved circular references when cleaning
REMOVE_RESOLVED=false

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Example 1: Basic migration (objects only)
# UPLOAD_ATTACHMENTS=false
# CONNECT_TICKETS_TO_OBJECTS=false
# AUTO_CREATE_OBJECT_TYPES=true
# AUTO_CREATE_REFERENCES=true

# Example 2: Full migration with attachments (v3.1 fixed)
# UPLOAD_ATTACHMENTS=true
# MAX_ATTACHMENTS_PER_OBJECT=10
# MAX_ATTACHMENT_SIZE_MB=100
# PARALLEL_ATTACHMENT_UPLOADS=true
# ATTACHMENT_UPLOAD_WORKERS=3

# Example 3: Full migration with tickets (v3.1 enhanced)
# CONNECT_TICKETS_TO_OBJECTS=true
# MAX_TICKETS_PER_OBJECT=10
# PARALLEL_TICKET_UPDATES=true
# TICKET_UPDATE_WORKERS=5

# Example 4: Complete migration (objects + attachments + tickets)
# UPLOAD_ATTACHMENTS=true
# CONNECT_TICKETS_TO_OBJECTS=true
# MAX_ATTACHMENTS_PER_OBJECT=15
# MAX_TICKETS_PER_OBJECT=15
# PARALLEL_ATTACHMENT_UPLOADS=true
# PARALLEL_TICKET_UPDATES=true
# MAX_ATTACHMENT_SIZE_MB=100

# Example 5: Conservative migration (slower but safer)
# UPLOAD_ATTACHMENTS=true
# CONNECT_TICKETS_TO_OBJECTS=true
# PARALLEL_ATTACHMENT_UPLOADS=false
# PARALLEL_TICKET_UPDATES=false
# ATTACHMENT_UPLOAD_WORKERS=1
# TICKET_UPDATE_WORKERS=1
# MAX_ATTACHMENTS_PER_OBJECT=5
# MAX_TICKETS_PER_OBJECT=5
# CREATE_DELAY=500
# MAX_RETRIES=5

# Example 6: High-performance migration (fast but higher API load)
# UPLOAD_ATTACHMENTS=true
# CONNECT_TICKETS_TO_OBJECTS=true
# PARALLEL_ATTACHMENT_UPLOADS=true
# PARALLEL_TICKET_UPDATES=true
# ATTACHMENT_UPLOAD_WORKERS=5
# TICKET_UPDATE_WORKERS=8
# MAX_ATTACHMENTS_PER_OBJECT=20
# MAX_TICKETS_PER_OBJECT=20
# CREATE_DELAY=50
# BATCH_SIZE=50

# =============================================================================
# RECENT FIXES APPLIED (v3.1)
# =============================================================================
# ✅ Attachment Upload: Fixed authentication (Basic auth) and path resolution
# ✅ Reference Processing: Fixed method errors causing 100% failure rate
# ✅ Text Validation: Added 255-character limit with auto-truncation
# ✅ Ticket Connection: Integrated into main migration flow (not post-migration)
# ✅ Phase Protection: Error isolation prevents migration interruptions
# =============================================================================

# =============================================================================
# QUICK START EXAMPLES
# =============================================================================

# Test migration (dry-run with small sample)
# DRY_RUN=true
# SCHEMA_FILTER=Application_Approval_Process
# LIMIT_PER_TYPE=5

# Production migration with all features
# UPLOAD_ATTACHMENTS=true
# CONNECT_TICKETS_TO_OBJECTS=true
# AUTO_CREATE_OBJECT_TYPES=true
# AUTO_CREATE_REFERENCES=true
# PARALLEL_ATTACHMENT_UPLOADS=true
# PARALLEL_TICKET_UPDATES=true

# Troubleshooting migration (detailed logging)
# DEBUG_API_CALLS=true
# DETAILED_ERROR_LOGGING=true
# VERBOSE_PROGRESS=true
# LOG_LEVEL=debug
